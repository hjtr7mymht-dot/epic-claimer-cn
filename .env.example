# 只跑 Epic（想加别的平台：epic,steam,prime,gog,...）
STORES=epic

# 时区与调度：每 12 小时跑一轮
TZ=Asia/Shanghai
SCHEDULER_HOURS=12
SCHEDULER_TIMEZONE=Asia/Shanghai

# noVNC 网页端口（登录 / 过验证码用）
NOVNC_PORT=7080

# 等你手动处理（登录、验证码）的秒数
VNC_LOGIN_TIMEOUT=1200

# 账号密码不是必需的：
# 首次运行打开 http://localhost:7080 手动登录一次，登录态保存在 fgc_data 卷里。
# 想完全无人值守再填，注意密码会明文躺在 .env 里。
# EG_EMAIL=you@example.com
# EG_PASSWORD=

# 可选通知（Apprise 语法，例如 Telegram / Discord / 邮件）
# NOTIFY=
